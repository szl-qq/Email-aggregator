# 本地配置示例：复制为 .env 后按需修改（.env 已在 .gitignore，不会进仓库）

# ---- 服务 ----
# PORT=3000

# ---- 账号密码加密密钥（生产部署务必改成随机 32 字节 hex） ----
# EMAIL_KEY=

# ---- 邮件翻译：单一 AI 模型（OpenAI 兼容接口） ----
# 本地网关示例（FreeLLMAPI / LM Studio / Ollama 等）
TRANSLATE_LLM_URL=http://127.0.0.1:31415/v1/chat/completions
TRANSLATE_LLM_KEY=your-api-key
TRANSLATE_LLM_MODEL=auto
TRANSLATE_TARGET=简体中文
# TRANSLATE_MAX_LEN=6000
# TRANSLATE_MAX_SEGS=80
